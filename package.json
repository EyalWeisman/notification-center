{
	"name": "@monorepo/root",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@8.15.9",
	"scripts": {
		"serve:all": "nx run-many --target=serve --all",
		"serve:shell": "nx serve shell",
		"serve:mfe": "nx serve mfe",
		"build:all": "nx run-many --target=build --all",
		"test:all": "nx run-many --target=test --all",
		"test:coverage:all": "nx run-many --target=test:coverage --all",
		"test:coverage:affected": "nx affected --target=test:coverage",
		"lint:all": "nx run-many --target=lint --all",
		"typecheck": "nx run-many --target=typecheck",
		"typecheck:affected": "nx affected --target=typecheck",
		"affected:test": "nx affected --target=test",
		"affected:build": "nx affected --target=build",
		"affected:lint": "nx affected --target=lint",
		"graph": "nx graph",
		"prepare": "husky install",
		"deps:check": "knip --dependencies",
		"deps:unused": "knip --include dependencies --exclude devDependencies",
		"deps:all": "knip --reporter compact",
		"prettier:format": "nx run-many --target=prettier:format --all",
		"prettier:format:affected": "nx affected --target=prettier:format"
