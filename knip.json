{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "apps/*/src/main.tsx",
    "packages/*/src/index.ts",
    "packages/*/src/cli.ts"
  ],
  "project": [
    "apps/*/src/**/*.{ts,tsx}",
    "packages/*/src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "**/coverage/**",
    "**/.nx/**",
    "**/eslint.config.mjs",
    "**/tsconfig*.json",
    "**/project.json",
    "tools/**",
    "**/README.md",
    "**/*.spec.{ts,tsx}",
    "**/*.test.{ts,tsx}",
    "**/test-setup.ts",
    "**/vitest.config.ts",
    "**/rsbuild.config.ts",
    "**/rslib.config.ts"
  ],
  "ignoreDependencies": [
    "@module-federation/runtime",
    "@module-federation/enhanced",
    "@module-federation/rsbuild-plugin",
    "@riverside/*"
  ]
}